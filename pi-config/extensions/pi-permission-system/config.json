{
  "debugLog": false,
  "doublePressToConfirm": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "path": {
      "read": "allow",
      "write": "ask",
      "edit": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
